# ============================================================
# Document Intelligence System — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- AI API Keys (required) ----
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5432/DocumentIntelligenceDb
DB_USER=postgres
DB_PASS=0000

# ---- JWT ----
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-string-minimum-32-chars
JWT_EXPIRY_MS=86400000

# ---- Storage Provider ----
# Options: LOCAL | S3 | AZURE_BLOB | SHAREPOINT
STORAGE_PROVIDER=LOCAL

# Local storage (used when STORAGE_PROVIDER=LOCAL)
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (used when STORAGE_PROVIDER=S3)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
# AWS credentials are read from ~/.aws/credentials or IAM role in ECS

# Azure Blob Storage (used when STORAGE_PROVIDER=AZURE_BLOB)
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=

# SharePoint / Microsoft Graph (used when STORAGE_PROVIDER=SHAREPOINT)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=dev
